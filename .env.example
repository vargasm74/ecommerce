APP_ENV=development

DB_HOST=db
DB_PORT=3306
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=ecommerce
DB_CHARSET=utf8mb4

APP_URL=http://localhost/frontend/
BACKEND_URL=http://localhost/backend/

GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# En produccion HTTPS usar true
SESSION_SECURE_COOKIE=false

# Activar solo cuando la aplicacion se publique exclusivamente por HTTPS
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000

APP_ENV=development
APP_PORT=8080
DB_FORWARD_PORT=3307

DB_HOST=db
DB_PORT=3306
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=ecommerce
DB_ROOT_PASSWORD=ecommerce_root
DB_CHARSET=utf8mb4

APP_URL=http://localhost:8080/frontend/
BACKEND_URL=http://localhost:8080/backend/

# Desarrollo local: permitir registro sin depender de un servidor SMTP
EMAIL_VERIFICATION_ENABLED=false

FACEBOOK_OAUTH_ENABLED=false

GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

MICROSOFT_OAUTH_ENABLED=false
MICROSOFT_TENANT=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8080/frontend/microsoft-callback.php

# En produccion HTTPS usar true
SESSION_SECURE_COOKIE=false

# Activar solo cuando la aplicacion se publique exclusivamente por HTTPS
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000

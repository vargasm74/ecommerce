Options -Indexes

RewriteEngine On

# No reescribir archivos ni directorios reales.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# URLs amigables: /frontend/calzado-para-dama -> index.php?ruta=calzado-para-dama
# También acepta paginación/orden: /frontend/calzado-para-dama/2/recientes
RewriteRule ^(.+?)/?$ index.php?ruta=$1 [QSA,L]
